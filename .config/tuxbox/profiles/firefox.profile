# TuxBox Profile
# Profile: Firefox
# Exported: 2026-05-26 23:34:22

[profile]
name = Firefox
app_id = firefox-esr
window_class = firefox-esr

[mappings]
c1 = KEY_LEFTCTRL+KEY_W
c2 = KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_T
dial_ccw = KEY_LEFTSHIFT+KEY_SPACE
dial_click = KEY_LEFTCTRL+KEY_D
dial_cw = KEY_SPACE
dpad_down = KEY_END
dpad_left = KEY_LEFTCTRL+KEY_PAGEUP
dpad_right = KEY_LEFTCTRL+KEY_PAGEDOWN
dpad_up = KEY_HOME
knob_ccw = KEY_LEFTCTRL+KEY_MINUS
knob_cw = KEY_LEFTCTRL+KEY_EQUAL
scroll_click = KEY_LEFTCTRL+KEY_F
scroll_down = REL_WHEEL:-1
scroll_up = REL_WHEEL:1
short = KEY_F5
side = KEY_LEFTALT+KEY_LEFT
tall = KEY_LEFTCTRL+KEY_T
top = KEY_LEFTALT+KEY_RIGHT
tour = KEY_LEFTCTRL+KEY_L

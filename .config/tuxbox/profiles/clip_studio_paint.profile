[profile]
name = Clip Studio Paint
app_id = clipstudiopaint.exe
window_class = clipstudiopaint.exe
haptic = strong
haptic_speed = fast

[mappings]
c1 = KEY_LEFTCTRL+KEY_Z
c2 = KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_Z
dial_ccw = KEY_LEFTCTRL+KEY_LEFTBRACE
dial_click = KEY_5
dial_cw = KEY_LEFTCTRL+KEY_RIGHTBRACE
dpad_down = KEY_P
dpad_left = KEY_T
dpad_right = KEY_LEFTCTRL+KEY_T
dpad_up = KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_R
knob_ccw = KEY_LEFTBRACE
knob_cw = KEY_RIGHTBRACE
scroll_click = KEY_2
scroll_down = REL_WHEEL:-1
scroll_up = KEY_LEFTCTRL+KEY_EQUAL
short = KEY_SPACE
side = KEY_LEFTCTRL
tall = KEY_B
top = KEY_LEFTSHIFT
tour = KEY_E

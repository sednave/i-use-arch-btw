# TuxBox Profile
# Profile: default
# Exported: 2026-05-26 23:34:22

[profile]
name = default

[mappings]
c1 = KEY_LEFTCTRL+KEY_Y
c2 = KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_Y
dial_ccw = REL_HWHEEL:-1
dial_click = KEY_CONTEXT_MENU
dial_cw = REL_HWHEEL:1
dpad_down = KEY_S
dpad_left = KEY_J
dpad_right = KEY_B
dpad_up = KEY_E
knob_ccw = KEY_LEFTCTRL+KEY_MINUS
knob_click = none
knob_cw = KEY_LEFTCTRL+KEY_EQUAL
scroll_click = KEY_ZOOMRESET
scroll_down = REL_WHEEL:-1
scroll_up = REL_WHEEL:1
short = KEY_SPACE
side = KEY_LEFTMETA
tall = KEY_LEFTALT
top = KEY_LEFTSHIFT
tour = KEY_INSERT
